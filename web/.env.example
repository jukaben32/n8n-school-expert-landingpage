# MentorIApp — Variables de entorno (Next.js)
# Copia este archivo a .env.local y completa los valores de tu proyecto Supabase.
# Panel de Supabase → Project Settings → API

# URL del proyecto (ej: https://abcdefghij.supabase.co)
NEXT_PUBLIC_SUPABASE_URL=

# Clave pública "anon" — segura para exponer en el navegador (protegida por RLS)
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Clave "service_role" — SOLO para uso en el servidor (Server Actions, scripts de seed).
# NUNCA debe llevar el prefijo NEXT_PUBLIC_ ni exponerse al navegador.
# Permite invitar personal a tener su propio login (crea usuarios de Auth).
SUPABASE_SERVICE_ROLE_KEY=

# URL pública donde vive la app (sin barra al final). En local:
# http://localhost:3000 — en producción, la de Vercel o tu dominio.
# Se usa para armar el enlace al que redirige el correo de invitación.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# API key de Anthropic (console.anthropic.com) — SOLO para uso en el
# servidor. NUNCA debe llevar el prefijo NEXT_PUBLIC_ ni exponerse al
# navegador. Necesaria para el Asistente de IA del Portal Familiar y para
# el escaneo OCR de fichas de inscripción / facturas de proveedores
# (web/src/lib/ocr/extractStructuredDocument.ts).
ANTHROPIC_API_KEY=

# Credenciales de Alegra (developer.alegra.com) — SOLO para uso en el
# servidor. Necesarias para sincronizar facturas de proveedores aprobadas
# (web/src/lib/accounting/alegra.ts). Sin estas variables, las facturas
# quedan aprobadas igual pero sin sincronizar -- ver ese archivo para el
# mapeo pendiente de definir (RNC→contacto, categoría→cuenta contable).
ALEGRA_EMAIL=
ALEGRA_TOKEN=

# API key de OpenAI (platform.openai.com) — SOLO para uso en el servidor.
# Necesaria para transcribir las notas de voz del Asistente de IA
# (modelo gpt-4o-mini-transcribe).
OPENAI_API_KEY=
# ProducciÃ³n del cliente:
# NEXT_PUBLIC_SITE_URL=https://educacionmanantial.com

# Conciliación automática con Alegra (7:00 pm, lunes a viernes).
# Secreto compartido que autoriza la llamada a /api/cron/alegra. Tiene que
# ser EL MISMO valor que private.app_settings.alegra_cron_secret en la base
# (ahí es donde pg_cron lo lee para firmar la llamada). Sin esta variable,
# la ruta responde 503 y no corre nada -- nunca queda abierta por omisión.
CRON_SECRET=

# Seguimiento automático del acceso de padres al Portal Familiar.
# Usa /api/cron/guardian-access-reminders con el mismo CRON_SECRET.
# Valores por defecto si se dejan vacíos: 3 intentos, primer recordatorio a las
# 24 horas del acceso creado, luego cada 48 horas.
GUARDIAN_ACCESS_MAX_REMINDERS=3
GUARDIAN_ACCESS_FIRST_REMINDER_HOURS=24
GUARDIAN_ACCESS_RESEND_HOURS=48

# A qué colegio pertenece la cuenta de Alegra configurada arriba. Con un
# solo colegio afiliado se resuelve solo y puede quedar vacía. En cuanto
# haya un segundo, es OBLIGATORIA -- si no, se le atribuirían a un colegio
# los cobros de otro. (Lo correcto entonces sería mover ALEGRA_EMAIL/TOKEN
# a configuración por colegio, como ya están las credenciales de Azul.)
ALEGRA_SCHOOL_ID=
