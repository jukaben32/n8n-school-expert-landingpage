# =========================================================
# SchoolOS — Variables de Entorno para Edge Functions
# =========================================================
# Copia como .env y completa los valores.
# NUNCA subas este archivo al repositorio con valores reales.

# ── Supabase (se inyectan automáticamente en producción) ──
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJhbGci...

# ── Seguridad del Webhook ──────────────────────────────────
# Genera un string aleatorio largo y colócalo también en el
# Dashboard de Supabase → Database Webhooks → Headers
WEBHOOK_SECRET=cambia_esto_por_un_secreto_aleatorio

# ── Anthropic Claude ───────────────────────────────────────
# Obtén tu API Key en: https://console.anthropic.com/
ANTHROPIC_API_KEY=sk-ant-...

# ── WhatsApp (Meta Cloud API) ──────────────────────────────
# Pasos: Meta for Developers → App → WhatsApp → API Setup
# 1. WHATSAPP_PHONE_ID: ID del número de teléfono registrado
# 2. WHATSAPP_API_TOKEN: Token permanente de tu app de Meta
WHATSAPP_PHONE_ID=123456789012345
WHATSAPP_API_TOKEN=EAAxxxxxxxx...

# ── Email (Resend) — Fallback si no hay WhatsApp ───────────
# Obtén tu API Key en: https://resend.com/api-keys
RESEND_API_KEY=re_xxxxxxxx...
